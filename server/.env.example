# Copy to server/.env and fill in. Never commit the real .env.
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Database used by the app and the demo
DB_NAME=restaurant_ordering_db
# Separate database used by `npm test` (created automatically). Default: <DB_NAME>_test
DB_NAME_TEST=restaurant_ordering_db_test
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret
